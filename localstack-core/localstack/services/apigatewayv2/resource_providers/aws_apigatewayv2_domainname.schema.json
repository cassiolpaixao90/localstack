{
  "typeName": "AWS::ApiGatewayV2::DomainName",
  "description": "Native LocalStack regional TLS 1.2 HTTP API custom domain subset",
  "additionalProperties": false,
  "primaryIdentifier": ["/properties/DomainName"],
  "readOnlyProperties": ["/properties/DomainNameArn", "/properties/RegionalDomainName", "/properties/RegionalHostedZoneId"],
  "createOnlyProperties": ["/properties/DomainName"],
  "properties": {
    "DomainName": {"type": "string", "minLength": 3, "maxLength": 253},
    "DomainNameArn": {"type": "string"},
    "DomainNameConfigurations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ApiGatewayDomainName": {"type": "string"},
          "CertificateArn": {"type": "string"},
          "DomainNameStatus": {"type": "string", "enum": ["AVAILABLE"]},
          "EndpointType": {"type": "string", "enum": ["REGIONAL"]},
          "HostedZoneId": {"type": "string"},
          "IpAddressType": {"type": "string", "enum": ["ipv4", "dualstack"]},
          "SecurityPolicy": {"type": "string", "enum": ["TLS_1_2"]}
        },
        "required": ["CertificateArn"]
      }
    },
    "RegionalDomainName": {"type": "string"},
    "RegionalHostedZoneId": {"type": "string"},
    "RoutingMode": {"type": "string", "enum": ["API_MAPPING_ONLY"]},
    "Tags": {"type": "object", "maxProperties": 50, "additionalProperties": {"type": "string"}}
  },
  "required": ["DomainName", "DomainNameConfigurations"],
  "handlers": {
    "create": {"permissions": ["apigateway:POST"]},
    "read": {"permissions": ["apigateway:GET"]},
    "list": {"permissions": ["apigateway:GET"]},
    "update": {"permissions": ["apigateway:PATCH", "apigateway:PUT", "apigateway:DELETE"]},
    "delete": {"permissions": ["apigateway:DELETE"]}
  },
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags"
  }
}
