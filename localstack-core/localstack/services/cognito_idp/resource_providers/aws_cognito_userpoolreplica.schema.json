{
  "typeName": "AWS::Cognito::UserPoolReplica",
  "description": "A secondary regional replica of a Cognito user pool.",
  "additionalProperties": false,
  "properties": {
    "RegionName": {"type": "string", "minLength": 5, "maxLength": 32, "pattern": "^[a-z]{2}(?:-[a-z0-9]+){1,3}-[0-9]$"},
    "UserPoolId": {"type": "string", "minLength": 1, "maxLength": 55, "pattern": "^[\\w-]+_[0-9a-zA-Z]+$"},
    "UserPoolTagsAtCreate": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": {"type": "string", "maxLength": 256}
    }
  },
  "required": ["RegionName", "UserPoolId"],
  "primaryIdentifier": ["/properties/UserPoolId", "/properties/RegionName"],
  "createOnlyProperties": [
    "/properties/RegionName",
    "/properties/UserPoolId",
    "/properties/UserPoolTagsAtCreate"
  ],
  "writeOnlyProperties": ["/properties/UserPoolTagsAtCreate"],
  "tagging": {"taggable": false},
  "handlers": {
    "create": {"permissions": ["cognito-idp:CreateUserPoolReplica", "cognito-idp:DeleteUserPoolReplica", "cognito-idp:ListUserPoolReplicas", "cognito-idp:UpdateUserPoolReplica"]},
    "read": {"permissions": ["cognito-idp:ListUserPoolReplicas"]},
    "update": {"permissions": ["cognito-idp:ListUserPoolReplicas"]},
    "delete": {"permissions": ["cognito-idp:DeleteUserPoolReplica", "cognito-idp:ListUserPoolReplicas", "cognito-idp:UpdateUserPoolReplica"]},
    "list": {"permissions": ["cognito-idp:ListUserPoolReplicas"]}
  }
}
