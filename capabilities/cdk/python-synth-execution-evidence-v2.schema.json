{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localstack.cloud/schemas/cdk-python-synth-execution-evidence-v2.json",
  "title": "LocalStack CDK Python synth execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "mode",
    "evidence_id",
    "claim_id",
    "subject",
    "run",
    "scenario",
    "toolchain",
    "verification_contract",
    "harness",
    "lanes",
    "promotion"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "aggregate"
    },
    "mode": {
      "const": "diagnostic-candidate"
    },
    "evidence_id": {
      "$ref": "#/$defs/sha256"
    },
    "claim_id": {
      "$ref": "#/$defs/sha256"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "const": "refs/heads/main"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "workflow_path",
        "run_id",
        "run_attempt",
        "event"
      ],
      "properties": {
        "provider": {
          "const": "github-actions"
        },
        "workflow_path": {
          "const": ".github/workflows/cdk-cli-blackbox.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "run_attempt": {
          "const": 1
        },
        "event": {
          "const": "push"
        }
      }
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "toolchain": {
      "$ref": "#/$defs/aggregateToolchain"
    },
    "verification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "cleanup",
        "supply_chain"
      ],
      "properties": {
        "assembly": {
          "$ref": "#/$defs/assemblyContract"
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "supply_chain": {
          "$ref": "#/$defs/supplyChainContract"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256"
      ],
      "properties": {
        "input_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            ".github/workflows/cdk-cli-blackbox.yml",
            ".python-version",
            "Makefile",
            "capabilities/cdk/compatibility.json",
            "capabilities/cdk/python-synth-execution-evidence-v2.schema.json",
            "localstack-core/localstack/cli/_cdk_health_probe.py",
            "localstack-core/localstack/cli/cdk.py",
            "pyproject.toml",
            "requirements-test.txt",
            "scripts/run_cdk_cli_blackbox_isolated.sh",
            "tests/aws/cli/execution_evidence.py",
            "tests/aws/cli/fixtures/cdk_apps/python/minimal_sqs.py",
            "tests/aws/cli/package-lock.json",
            "tests/aws/cli/package.json",
            "tests/aws/cli/python-synth-requirements.lock",
            "tests/aws/cli/python-synth-wheel-origins.json",
            "tests/aws/cli/python_synth_execution_evidence_v2.py",
            "tests/aws/cli/python_synth_toolchain.py",
            "tests/aws/cli/test_cdk_cli_blackbox.py",
            "tests/aws/cli/test_cdk_cli_bootstrap_upgrade.py",
            "tests/aws/cli/test_cdk_cli_python_synth.py",
            "tests/aws/cli/validate_junit.py"
