{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:localstack-fork:cdk-compatibility:v2",
  "title": "AWS CDK compatibility and execution evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "scope",
    "sources",
    "policy",
    "languages",
    "toolchain",
    "launcher",
    "current_evidence",
    "execution_scenarios",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "scope": {"const": "planning-baseline"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "policy": {"$ref": "#/$defs/policy"},
    "languages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/language"}
    },
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "launcher": {"$ref": "#/$defs/launcher"},
    "current_evidence": {"$ref": "#/$defs/currentEvidence"},
    "execution_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/executionScenario"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "languageId": {"enum": ["typescript", "javascript", "python", "java", "csharp", "go"]},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "retrieved_at", "claim"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date"},
        "claim": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "license_uri": {"type": "string", "format": "uri"},
        "license_sha256": {"$ref": "#/$defs/hash"},
        "local_license_path": {"type": "string", "minLength": 1},
        "upstream_notice_uri": {"type": "string", "format": "uri"},
        "upstream_notice_sha256": {"$ref": "#/$defs/hash"},
        "local_attribution_path": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_granularity",
        "language_neutral_boundary",
        "new_stable_bindings",
        "aws_validation_max_age_days",
        "required_platforms"
      ],
      "properties": {
        "claim_granularity": {"const": "exact-toolchain-language-scenario"},
        "language_neutral_boundary": {"const": "cloud-assembly-and-aws-apis"},
        "new_stable_bindings": {"const": "automatically-required"},
        "aws_validation_max_age_days": {"type": "integer", "minimum": 1},
        "required_platforms": {"$ref": "#/$defs/stringArray"}
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "init_value", "official_stability", "support_gate", "ecosystem", "coordinate"],
      "properties": {
        "id": {"$ref": "#/$defs/languageId"},
        "init_value": {"type": "string", "minLength": 1},
        "official_stability": {"const": "stable"},
        "support_gate": {"const": "required"},
        "ecosystem": {"type": "string", "minLength": 1},
        "coordinate": {"type": "string", "minLength": 1}
      }
    },
    "versionLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "pinned", "tested"],
      "properties": {
        "minimum": {"type": ["string", "null"]},
        "pinned": {"type": ["string", "null"]},
        "tested": {"$ref": "#/$defs/stringArray"}
      }
    },
    "bootstrapTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "source_id": {"type": "string", "minLength": 1},
        "upstream_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "retrieved_at": {"type": "string", "format": "date"},
        "byte_exact": {"const": true}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "cdk_cli", "construct_library", "cloud_assembly", "bootstrap"],
      "properties": {
        "node": {"$ref": "#/$defs/versionLane"},
        "cdk_cli": {"$ref": "#/$defs/versionLane"},
        "construct_library": {"$ref": "#/$defs/versionLane"},
        "cloud_assembly": {"$ref": "#/$defs/versionLane"},
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latest_official_version", "observed_templates"],
          "properties": {
            "latest_official_version": {"type": "integer", "minimum": 1},
            "observed_templates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/bootstrapTemplate"}}
          }
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "executable", "minimum_cli_for_endpoint_mode", "process_supervision", "environment", "safety"],
      "properties": {
        "mode": {"const": "thin-supervisor"},
        "executable": {"const": "standard-cdk"},
        "minimum_cli_for_endpoint_mode": {"type": "string", "minLength": 1},
        "process_supervision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "boundary", "detached_descendants"],
          "properties": {
            "platform": {"const": "posix"},
            "boundary": {"const": "process-group"},
            "detached_descendants": {"const": "not-contained"}
          }
        },
        "environment": {"$ref": "#/$defs/stringArray"},
        "safety": {"$ref": "#/$defs/stringArray"}
      }
    },
    "currentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_construct_language",
        "real_cli_exercised",
        "real_cli_scenario_ids",
        "cloud_assembly_produced",
        "freshness",
        "critical_snapshot_exclusions",
        "local_paths"
      ],
      "properties": {
        "api_construct_language": {"const": "python"},
        "real_cli_exercised": {"const": true},
        "real_cli_scenario_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "cloud_assembly_produced": {"const": false},
        "freshness": {"enum": ["missing", "stale", "fresh"]},
        "critical_snapshot_exclusions": {"type": "boolean"},
        "local_paths": {"$ref": "#/$defs/stringArray"}
      }
    },
    "executionScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "construct_language",
        "platforms",
        "source_commit",
        "run_id",
        "run_attempt",
        "artifact_path",
        "artifact_sha256",
        "evidence_id",
        "claim_id",
        "attestation_path",
        "attestation_sha256",
        "toolchain",
        "limitations"
      ],
      "properties": {
        "id": {"enum": ["bootstrap-show-template-v32", "bootstrap-upgrade-v28-v32"]},
        "status": {"const": "cli-pass"},
        "construct_language": {"type": "null"},
        "platforms": {
          "type": "array",
          "prefixItems": [{"const": "linux-amd64"}, {"const": "linux-arm64"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"const": 1},
        "artifact_path": {
          "type": "string",
          "pattern": "^capabilities/cdk/evidence/runs/[1-9][0-9]*/(?:cdk-cli|cdk-bootstrap-upgrade)-execution-evidence\\.json$"
        },
        "artifact_sha256": {"$ref": "#/$defs/hash"},
        "evidence_id": {"$ref": "#/$defs/hash"},
        "claim_id": {"$ref": "#/$defs/hash"},
        "attestation_path": {
          "type": "string",
          "pattern": "^capabilities/cdk/evidence/runs/[1-9][0-9]*/(?:cdk-cli|cdk-bootstrap-upgrade)-execution-evidence\\.sigstore\\.json$"
        },
        "attestation_sha256": {"$ref": "#/$defs/hash"},
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "cdk_cli", "bootstrap"],
          "properties": {
            "node": {"type": "string", "minLength": 1},
            "cdk_cli": {"type": "string", "minLength": 1},
            "source_bootstrap": {"type": "integer", "minimum": 1},
            "bootstrap": {"type": "integer", "minimum": 1}
          }
        },
        "limitations": {"$ref": "#/$defs/stringArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "bootstrap-show-template-v32"}}, "required": ["id"]},
          "then": {
            "properties": {
              "artifact_path": {
                "pattern": "^capabilities/cdk/evidence/runs/[1-9][0-9]*/cdk-cli-execution-evidence\\.json$"
              },
              "attestation_path": {
                "pattern": "^capabilities/cdk/evidence/runs/[1-9][0-9]*/cdk-cli-execution-evidence\\.sigstore\\.json$"
              },
              "toolchain": {
                "not": {"required": ["source_bootstrap"]},
                "properties": {"bootstrap": {"const": 32}}
              },
              "limitations": {
                "type": "array",
                "prefixItems": [
                  {"const": "no-bootstrap-deploy"},
                  {"const": "no-cloud-assembly"},
                  {"const": "no-language-binding"},
                  {"const": "no-aws-differential"}
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "bootstrap-upgrade-v28-v32"}}, "required": ["id"]},
          "then": {
            "properties": {
              "artifact_path": {
                "pattern": "^capabilities/cdk/evidence/runs/[1-9][0-9]*/cdk-bootstrap-upgrade-execution-evidence\\.json$"
              },
              "attestation_path": {
                "pattern": "^capabilities/cdk/evidence/runs/[1-9][0-9]*/cdk-bootstrap-upgrade-execution-evidence\\.sigstore\\.json$"
              },
              "toolchain": {
                "required": ["source_bootstrap"],
                "properties": {
                  "source_bootstrap": {"const": 28},
                  "bootstrap": {"const": 32}
                }
              },
              "limitations": {
                "type": "array",
                "prefixItems": [
                  {"const": "no-clean-bootstrap-create"},
                  {"const": "no-cloud-assembly"},
                  {"const": "no-language-binding"},
                  {"const": "no-aws-differential"}
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "languages", "dependencies", "evidence", "gaps"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "status": {
          "enum": ["untested", "template-only", "template-api-only", "api-simulated", "blocked", "cli-pass", "parity-pass"]
        },
        "languages": {
          "type": "array",
          "items": {"$ref": "#/$defs/languageId"},
          "uniqueItems": true
        },
        "dependencies": {"$ref": "#/$defs/stringArray"},
        "evidence": {"$ref": "#/$defs/stringArray"},
        "gaps": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
