{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:localstack-fork:capability-evidence:v1",
  "title": "LocalStack informational capability evidence overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "semantic_sha256",
    "mode",
    "base",
    "observed_at",
    "inputs",
    "summary",
    "operations",
    "invalid_samples"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"$ref": "#/$defs/hash"},
    "semantic_sha256": {"$ref": "#/$defs/hash"},
    "mode": {"const": "informational"},
    "base": {"$ref": "#/$defs/base"},
    "observed_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"}
    },
    "invalid_samples": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/invalidSample"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "traceClass": {
      "enum": [
        "native-observed",
        "fallback-observed",
        "mock-observed",
        "missing-observed",
        "error-observed",
        "unsupported-observed",
        "unknown-observed",
        "invalid-observed"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_catalog_sha256", "inventory_sha256", "source_commit"],
      "properties": {
        "model_catalog_sha256": {"$ref": "#/$defs/hash"},
        "inventory_sha256": {"$ref": "#/$defs/hash"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "csv_schema",
        "rows_seen",
        "valid_rows",
        "invalid_rows"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "csv_schema": {"const": "legacy-v1-informational"},
        "rows_seen": {"$ref": "#/$defs/nonNegativeInteger"},
        "valid_rows": {"$ref": "#/$defs/nonNegativeInteger"},
        "invalid_rows": {"$ref": "#/$defs/nonNegativeInteger"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_seen",
        "valid_rows",
        "invalid_rows",
        "operations_observed",
        "by_trace_class"
      ],
      "properties": {
        "rows_seen": {"$ref": "#/$defs/nonNegativeInteger"},
        "valid_rows": {"$ref": "#/$defs/nonNegativeInteger"},
        "invalid_rows": {"$ref": "#/$defs/nonNegativeInteger"},
        "operations_observed": {"$ref": "#/$defs/nonNegativeInteger"},
        "by_trace_class": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/traceClass"},
          "additionalProperties": {"$ref": "#/$defs/nonNegativeInteger"}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "operation",
        "observations",
        "trace_classes",
        "trace_class_counts",
        "origins",
        "outcomes",
        "max_trace_depth",
        "samples",
        "aws_validated_marker_observed",
        "snapshot_marker_observed",
        "snapshot_skip_observed",
        "xfail_marker_observed",
        "promotion"
      ],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "observations": {"type": "integer", "minimum": 1},
        "trace_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/traceClass"},
          "uniqueItems": true
        },
        "trace_class_counts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/traceClass"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "origins": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 64},
          "uniqueItems": true
        },
        "outcomes": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 64},
          "uniqueItems": true
        },
        "max_trace_depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/sample"}
        },
        "aws_validated_marker_observed": {"type": "boolean"},
        "snapshot_marker_observed": {"type": "boolean"},
        "snapshot_skip_observed": {"type": "boolean"},
        "xfail_marker_observed": {"type": "boolean"},
        "promotion": {"$ref": "#/$defs/promotion"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_node_id", "trace_sha256"],
      "properties": {
        "test_node_id": {"type": "string", "minLength": 1, "maxLength": 2048},
        "trace_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "invalidSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "line", "error"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 2},
        "error": {"type": "string", "minLength": 1}
      }
    }
  }
}
